<!--
  The Paradis EZ wordmark, as used by every Paradis EZ Utilities app: "PARADIS" + an E with a
  hand-drawn red Z over it (read together: "PARADIS EZ") + the app's name, here "TRIM".
  Adapted from Paradis Capture's Wordmark.xaml so the two apps match. It's drawn with Segoe UI
  and two vector strokes, so it needs no image or font files. Set Height to size it.
  To swap in a final logo image later, replace the contents of this one file.
-->
<UserControl x:Class="ParadisTrim.Controls.Wordmark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False" Focusable="False"
             AutomationProperties.Name="Paradis EZ Trim">
  <Viewbox Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" TextOptions.TextFormattingMode="Ideal" SnapsToDevicePixels="False">
      <TextBlock Text="PARADIS" FontFamily="Segoe UI" FontWeight="Bold" FontSize="28"
                 Foreground="{StaticResource TextBrush}" />
      <Grid>
        <TextBlock Text="E" FontFamily="Segoe UI" FontWeight="Bold" FontSize="28"
                   Foreground="{StaticResource SubtleTextBrush}" Opacity="0.85" />
        <!-- The red Z over the E: the 13 × 9.7 drawing is stretched onto the E's cap height. -->
        <Viewbox Stretch="Fill" Margin="-3,8,-7,5" IsHitTestVisible="False">
          <Canvas Width="13" Height="9.7">
            <Path Stroke="{StaticResource BrandRedBrush}" StrokeThickness="0.9" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M4.6,2.0 C7,1.3 9.4,0.6 11.8,0 L0.6,9.4 C4.4,8.2 8.4,7.7 12.6,7.4" />
            <Path Stroke="{StaticResource BrandRedBrush}" StrokeThickness="0.47" Opacity="0.85"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M3.6,2.9 C5.8,2.2 8,1.6 10,1.2 M5,9.0 C7.8,8.4 10.4,8.2 13,8.2" />
          </Canvas>
        </Viewbox>
      </Grid>
      <TextBlock Text="TRIM" FontFamily="Segoe UI" FontWeight="Light" FontSize="28" Margin="12,0,0,0"
                 Foreground="{StaticResource TextBrush}" />
    </StackPanel>
  </Viewbox>
</UserControl>
